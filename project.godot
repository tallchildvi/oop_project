; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="oop_project"
run/main_scene="res://Scenes/main_menu.tscn"
config/features=PackedStringArray("4.5", "C#", "Mobile")
config/icon="res://icon.svg"

[autoload]

EventManager="*res://Scenes/EventManager.cs"
MenuManager="*res://Scenes/MenuManager.cs"
ILevelBuilder="*res://Scenes/ILevelBuilder.cs"
LevelManager="*res://Scenes/LevelBuilder.cs"

[dotnet]

project/assembly_name="oop_project"

[rendering]

renderer/rendering_method="mobile"
